## 5. Application Configuration

### [HT-CONFIG] haven-terminus.compose.yaml

```yaml
app:
  id: haven-terminus

  transports:
    - type: mqtt
      broker: mqtt-broker.local
      port: 1883

namespaces:
  # ── Exported (dashboard-visible) ──
  - name: presence_status
    state_engine:
      type: enum
      values: [active, idle, busy, away, extended_away, offline]
    export: true
    label: "Human Presence"

  - name: sessions_active
    state_engine: continuous_0_255
    export: true
    label: "Active Sessions"

  - name: connection_status
    state_engine:
      type: enum
      values: [connecting, connected, disconnected, error]
    export: true
    label: "Terminus Status"

  # ── Imported (remote control) ──
  - name: dashboard_cmd
    state_engine:
      type: enum
      values: [none, refresh, launch_architect, launch_builder]
    import: true
    label: "Dashboard Command"

  # ── Event-only namespaces (_app/presence/interaction, _app/presence/break_toggle,
  #    _app/sessions/launch_request, _app/sessions/launch_result,
  #    _app/discussion/fetch_request, _app/discussion/post_request,
  #    _app/discussion/post_result) are auto-registered from MODULE_MANIFEST
  #    at runtime — no YAML entry required for event-only namespaces.

  # ── Private: Presence ──
  - name: _app/presence/state
    state_engine:
      type: enum
      values: [active, idle, busy, away, extended_away, offline]
    route_external: true
    route_as: debug/presence_state

  - name: _app/presence/idle_seconds
    state_engine: continuous_0_255

  # ── Private: Sessions ──
  - name: _app/sessions/list
    state_engine: binary

  # ── Private: Discussion ──
  - name: _app/threads/list
    state_engine: binary

  - name: _app/discussion/active
    state_engine: binary

  - name: _app/connection/status
    state_engine:
      type: enum
      values: [connecting, connected, disconnected, error]

  # ── Private: UI state ──
  - name: _app/ui/focused_pane
    state_engine:
      type: enum
      values: ["0", "1"]

  - name: _app/ui/split_mode
    state_engine: binary

  - name: _app/ui/selected_thread
    state_engine: binary
```

