{
  "contract": "0.1",
  "domain": "hello_world",
  "name": "Hello World",
  "version": "1.0.0",
  "description": "The conformance fixture: greets on the bus and answers each ping with a pong.",
  "documentation": "https://example.invalid/compose-plugins/hello_world",
  "issue_tracker": "https://example.invalid/compose-plugins/hello_world/issues",
  "codeowners": [
    "@740Dave"
  ],
  "requirements": [],
  "run": {
    "form": "python",
    "entry": "hello_world.plugin:HelloWorld"
  },
  "isolation_floor": "inprocess",
  "hosts": {
    "composeio": {},
    "gnomon": {}
  },
  "config_schema": {
    "properties": {
      "greeting": {
        "default": "hello",
        "title": "Greeting",
        "type": "string"
      }
    },
    "title": "Config",
    "type": "object"
  },
  "bus": {
    "publishes": [
      {
        "namespace": "plugins/hello_world/greeting",
        "type": "STATE"
      },
      {
        "namespace": "plugins/hello_world/pong",
        "type": "EVENT"
      }
    ],
    "subscribes": [
      {
        "namespace": "plugins/hello_world/ping",
        "type": "EVENT"
      }
    ]
  }
}
