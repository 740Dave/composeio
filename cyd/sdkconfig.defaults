CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WiFi memory optimization — CYD has no PSRAM, framebuffer needs ~75-150KB
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# WiFi credentials (for menuconfig reference — code uses wifi_config.h defines)
CONFIG_ESP_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_ESP_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# HTTP client for capture push
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# R3 reactive tier: binding expr parse/eval runs on the main task; the
# DSL's hard bounds need real stack headroom (dsl.h: worst-case parser
# ~29KB).  24KB covers every sane config and fails gracefully beyond.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# FATFS for SD card
CONFIG_FATFS_LONG_FILENAMES=y
CONFIG_FATFS_LFN_HEAP=y
