# ESP32-S3 overrides (env:qualia_s3_dsl_test) — layered after sdkconfig.defaults.
# [SPEC:CXC-EMBED-REACTIVE] R4.  The connected Adafruit Qualia ESP32-S3
# enumerates over the chip's native USB-Serial-JTAG (/dev/cu.usbmodem31101):
# make it the PRIMARY console so the DSL corpus harness printf output lands
# on the monitored usbmodem port (same idiom as the C3's sdkconfig.c3.defaults).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
