/*
 * wifi_config.h.example — copy to wifi_config.h and fill in your values.
 *
 * The real wifi_config.h is gitignored: it holds network credentials and
 * must not be committed. This template documents the expected #defines.
 */

#pragma once

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

/* Document store endpoint for capture push.
 * Use an IP address — mDNS (.local) resolution is not available on the CYD. */
#define DOCUMENT_STORE_URL "http://192.0.2.x:8421"

/* Bus storage endpoint — config + asset fetch ([CXC-R-BOOT]):
 * bus://assets/displays/<device_id>.compose.yaml lives here. */
#define BUS_STORAGE_URL "http://192.0.2.x:8420"

/* ComposeBus MQTT broker ([SPEC:CXC-EMBED-REACTIVE] R3 reactive tier) —
 * devices ride the shared ecosystem broker on :1883. */
#define MQTT_BROKER_URI "mqtt://192.0.2.x:1883"

/* Optional fixed device identity. When NOT defined, the device is
 * "cyd-<last 3 MAC octets>" (printed at boot) — assign its config in
 * bus_storage, zero firmware changes ([CXC-R-BOOT-FUNGIBLE]). */
/* #define DISPLAY_DEVICE_ID "cyd-desk-01" */
