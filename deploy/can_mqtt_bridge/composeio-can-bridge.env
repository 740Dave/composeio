# /etc/default/composeio-can-bridge — installed by
# deploy/can_mqtt_bridge/deploy.sh. THE REPO IS THE SOURCE OF TRUTH: edits made
# on the host are overwritten by the next deploy. Change it here and redeploy.
#
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell expansion.

# --- CAN side --------------------------------------------------------------
# ONE channel. On the Waveshare 2-CH CAN HAT, can1 is deliberately left free as
# the test harness's channel (the two are physically jumpered CAN_H<->CAN_H /
# CAN_L<->CAN_L with 120R at both ends). Kernel interface names come from SPI
# probe order and do NOT necessarily match the silkscreen.
CAN_INTERFACE=can0

# Log-line only. The bitrate is an INTERFACE property set by can0.service
# (`ip link set can0 type can bitrate 500000`), never a userspace socket arg.
CAN_BITRATE=500000

# --- MQTT side -------------------------------------------------------------
MQTT_BROKER=mqtt-broker.local
MQTT_PORT=1883
MQTT_PREFIX=composeio

# Distinct per deployment. Two clients sharing an id on one broker evict each
# other in a reconnect loop, which reads as intermittent packet loss. It also
# names this bridge's own status namespaces: `_bridge/<this>/forwarding`,
# `/drops`, `/denylist`, published every CAN_BRIDGE_STATUS_S seconds.
MQTT_CLIENT_ID=composeio-can-bridge-rpi5

# --- MQTT -> CAN filtering -------------------------------------------------
# THE BRIDGE NOW ALWAYS SUBSCRIBES `composeio/#` AND FILTERS IN-PROCESS.
# It used to narrow at SUBSCRIBE time, which meant filtered traffic never
# reached the process and the `filtered` counter could not increment — the line
# `allowlist dropped 0` was an arithmetic identity, not a measurement. Every
# decision now happens where it can be counted, named and published.
#
# WHAT THE FIREHOSE ACTUALLY COSTS, MEASURED (2026-08-12, 20 s of the live
# production broker at mqtt-broker.local, sampled read-only):
#     184 messages   9.2 msg/s across 31 namespaces
#     119 of 184 (65%) encode to MORE than 8 bytes and are now DROPPED by the
#         representability gate rather than truncated — dradis/bodies and
#         dradis/contacts are 201 B, _app/console/bbox is 43 B
#      61 of 184 would actually reach CAN = 3.0 frames/s
#     against a MEASURED segment ceiling of ~2000 frames/s, that is 0.2% of
#     the frame budget.
# So the "firehose" the allowlist existed to stop is, with DROP-not-truncate in
# place, 0.2% of capacity. The old bridge's danger was never the message RATE:
# it was that it TRUNCATED 65% of them to 8-byte fragments that decode cleanly
# as different values.
#
# CAN_BRIDGE_DENYLIST is the current mechanism. Comma- or space-separated;
# `fnmatch` patterns allowed, so a family is one entry. Default is EMPTY.
# These are denied as a statement of INTENT — the representability gate already
# refuses every one of them for being oversize, and the published census on
# `_bridge/<id>/drops` shows both, so intent and reality can be compared
# instead of assumed equal.
CAN_BRIDGE_DENYLIST=dradis/*,_app/*,self/*,intelligence/*

# --- MQTT -> CAN allowlist (DEPRECATED — NOW UNSET, migration COMPLETE) ----
# ⛔ THE LINE IS GONE ON PURPOSE. Do not re-add it. `CAN_BRIDGE_ALLOWLIST` is
# still honored by the code (a deployment that relies on it must not be silently
# widened), so setting it here would silently re-impose the state below.
#
# WHAT IT WAS DOING, MEASURED ON THE LIVE BRIDGE (2026-08-15, 6.8 h uptime):
#     registered 94, learned_from_mqtt 71 — and `name_to_hash`, the table of
#     what ACTUALLY CROSSED, held exactly TWO entries:
#         throttle/left 0x03F6, throttle/right 0x0D9E
#     by_reason: denied 153921, encode_error 9, self 15006
# 94 namespaces known, 2 crossing. The allowlist was not a filter any more; it
# was the reason the segment was almost empty, and because an allowlist reports
# nothing about what it excluded, nothing said so. `_device/*` — every restart,
# every announcement, the whole control plane — was in the denied 153921.
#
# THE COST OF REMOVING IT, from the 2026-08-12 sample above: ~3 frames/s of
# small representable values (sys/cpu, game/*, _bus/time, fun/nightwatch/*)
# begin crossing, against a MEASURED segment ceiling of ~2000 frames/s = 0.2%
# of the frame budget. ⚠ THAT NUMBER IS WITH `CAN_BRIDGE_DENYLIST` STILL IN
# FORCE (the line above): dradis/*, _app/*, self/* and intelligence/* are the
# high-rate families and they remain denied. Removing the deny list too is a
# DIFFERENT change with a different measurement and has not been made.
#
# David ratified the removal 2026-08-15.

# --- CAN -> MQTT namespace registration ------------------------------------
# MOSTLY OBSOLETE, and that is the point. The registry is now SELF-POPULATING
# and BIDIRECTIONAL: every namespace the bridge observes on MQTT registers
# name->hash AND hash->name, because the bridge never needs to REVERSE a hash —
# it needs to have seen the NAME once. So anything that crosses down is
# nameable coming back up with no configuration at all.
#
# This variable is now the FALLBACK for namespaces that exist ONLY on the CAN
# side and therefore can never be learned from MQTT observation. The BSG game
# vocabulary is built in; list extra CAN-only namespaces here.
#
# 2026-08-12 — the ESP32-C3 Super Mini CAN first-light node
# (cyd/[env:esp32_c3_can_bringup], device id `c3can-c28020`, MAC
# AA:BB:CC:DD:EE:FF). It is the fleet's FIRST MCU to put frames ON a segment
# rather than only take them off one, and every namespace it speaks is
# CAN-ONLY: nothing on MQTT ever publishes `_device/c3can-c28020/*`, so the
# self-populating registry can never learn these names by observation. Without
# them listed here the bridge drops every frame as an unresolvable hash —
# correctly and loudly, on `_bridge/<id>/drops`, which is exactly how this list
# was found to be needed rather than guessed at.
#
# THIS IS A DESIGN SMELL WORTH NAMING, not a chore to be done quietly: the
# namespaces embed a DEVICE ID, so a second CAN node — or this one reflashed
# onto different silicon — needs nine more hand-typed entries whose only error
# report is a hash nobody can reverse. A `_device/*` prefix rule on the CAN->
# MQTT side, or hash registration announced by the node itself over
# DISCOVERY, would remove the hand-maintenance. Recorded here rather than
# fixed here: a first light and a registry redesign are two blast radii.
#
# ---------------------------------------------------------------------------
# 2026-08-13 — DEVICE SELF-ANNOUNCEMENT LANDED, AND THIS LIST IS *NOT* THE
# ANSWER FOR IT. ([SPEC:CXC-BOARD-HW] workstream 0.2)
# ---------------------------------------------------------------------------
# Every board in the shared baseline now publishes five namespaces:
#     _device/<id>/heartbeat  _device/<id>/build     _device/<id>/transport
#     _device/<id>/scene      _device/<id>/health
# plus it subscribes _device/broadcast/announce and _device/<id>/announce.
#
# On MQTT and UART those work TODAY. On CAN they do not reach this bridge, and
# the reason is structural rather than a missing entry here:
#
#   the 16-bit wire id is a hash of the FULL namespace name, INCLUDING the
#   device id — so a `_device/*` prefix rule cannot be expanded without
#   already knowing every device id, which is precisely the thing being
#   discovered.
#
# So a prefix rule is not merely absent, it is IMPOSSIBLE at this layer. What
# closes it is workstream G's well-known root: ONE namespace with a fixed hash
# (`_device/announce`) pre-registered in every bridge and every node, over
# which a node announces its own namespace NAMES (chunked via config_chunk,
# which is already substrate-independent and host-proven). The bridge then
# learns name->hash in both directions, exactly as it already learns from
# observing MQTT.
#
# ⚠ ENTRIES FOR THE ANNOUNCEMENT NAMESPACES ARE DELIBERATELY NOT ADDED HERE.
# Adding five lines for one known board would make `composeio fleet` show that
# board and silently omit every board whose id nobody typed — a fleet census
# that is confidently incomplete is worse than one that is honestly empty, and
# it is the same class of error as the `filtered` counter that could not
# increment. The CAN-side gap is stated in the tool's own output instead.
#
# If a bench situation genuinely needs one CAN board visible before G lands,
# append its five namespaces here AS A STOPGAP and say so in the session log —
# do not let it stand in for the mechanism.
#
# ---------------------------------------------------------------------------
# 2026-08-13 (later) — WORKSTREAM G LANDED. THE ENTRIES ABOVE ARE STILL NOT
# THE ANSWER, AND NOW THEY ARE ALSO NOT NEEDED — for boards that ANNOUNCE.
# ---------------------------------------------------------------------------
# `_device/announce` = 0x31AE is pre-registered in the bridge AT IMPORT (not
# here, not by any variable — it is protocol, and a thing an operator can edit
# is a thing an operator can break). A node chunks its namespace NAMES over it
# and the bridge learns name->hash exactly as it learns from MQTT, collision
# rule and all. So `_device/<id>/*` needs NO entry above.
#
# ⚠ THE `c3can-c28020` ENTRIES ARE DELIBERATELY LEFT IN PLACE. That board is
# running firmware from BEFORE ns_announce — it cannot announce, so removing
# its nine lines would un-name a node that works today, to prove a point about
# a mechanism it does not have. G5 (retire the hand-typed list) is a REFLASH
# task, not an edit here. Delete them in the same change that flashes it, and
# not before.
#
# --- persisting the learned table (workstream G4) --------------------------
# Where the LEARNED half of the registry is written, so a bridge restart does
# not un-name every CAN-only device until each board is polled again. Only
# `mqtt`- and `can`-provenance entries are written; the built-ins and the list
# above are re-derived from code and from this file every boot, so a stale file
# can never override a change made here.
#
# Every entry is RE-VERIFIED against the hash function on load and refused if
# it disagrees, and the whole table — with provenance per row — goes out on
# `_bridge/<id>/forwarding` every CAN_BRIDGE_STATUS_S seconds. That publication
# is not decoration: persisted learning can persist a MISTAKE, and a state file
# nobody can see is a configuration file nobody wrote.
#
# UNSET means persistence is OFF, and the bridge says so at startup. There is
# deliberately no default path — a hidden state file changes the answer at
# exactly the moment an operator restarts a misbehaving bridge.
#
# The path is the unit's `StateDirectory=composeio-can-bridge`. It has to be
# that and not an arbitrary path: the unit runs ProtectSystem=strict, so every
# other location on this host is read-only to the service.
CAN_BRIDGE_REGISTRY_FILE=/var/lib/composeio-can-bridge/registry.json

# One `_device/broadcast/announce` frame on the segment at startup, so nodes
# re-announce into a table this process has just lost. One frame; set to 0 to
# suppress it (then names are learned only when a board announces on its own
# boot). The OUTBOUND direction never needed a registry — a hash is computed
# from a name the sender already has — so this works on the first frame.
CAN_BRIDGE_ANNOUNCE_POLL=1
CAN_BRIDGE_REGISTER=_device/c3can-c28020/heartbeat,_device/c3can-c28020/status,_device/c3can-c28020/twai/tx_error_counter,_device/c3can-c28020/twai/rx_error_counter,_device/c3can-c28020/twai/tx_failed_count,_device/c3can-c28020/twai/rx_missed_count,_device/c3can-c28020/twai/rx_overrun_count,_device/c3can-c28020/twai/bus_error_count,_device/c3can-c28020/twai/msgs_to_rx

# --- node identity ---------------------------------------------------------
# This bridge's ALLOCATED 4-bit `src` node id ([BP-CAN-ID] v2), 1..15.
#
# ⚠ THIS KEY WAS ABSENT UNTIL 2026-08-15, so the bridge ran at the default 0 =
# UNASSIGNED and every frame it put on the wire carried src=0.  Measured on the
# live bus that day: `throttle/right` went out as id=0x04036781, which decodes
# to src=0.  The c3lcd-c28020 board is ALSO unassigned, so the segment had TWO
# nodes both claiming 0 — the arbitration hazard [DEC-UNASSIGNED-SRC-IMPLIES-
# LISTEN-ONLY] exists to prevent.  Two unassigned nodes emitting the same
# namespace+type produce BYTE-IDENTICAL 29-bit ids with different data, which
# is a bit error, TEC +8 on both, retransmit — a self-sustaining error storm
# that looks exactly like a wiring fault.
#
# ⛔ DO NOT "fix" the bridge by applying the src==0 => listen-only rule to it.
# That rule is correct for a LEAF, but the bridge is the segment's only real
# transmitter: muting it would take the whole CAN side down and would read as
# a dead bus.  The fix is ALLOCATION, which is this line.
#
# Node id 1 is the bridge because it is the fleet's fixed infrastructure peer;
# leaves should be allocated upward from 2.  Fifteen ids is a REAL ceiling, not
# a comfortable one — it is a diagnostic ("which box put this on the wire"),
# never an address, so reuse across separate segments is fine.
CAN_BRIDGE_NODE_ID=1

# --- observability ---------------------------------------------------------
# Forwarding-table publication period, seconds. PERIODIC, not on-change: a
# table published only when it changes cannot be told apart from a dead bridge,
# so a MISSING publication is itself the liveness signal. Set to 0 to disable,
# which the bridge warns about because it makes itself unobservable.
CAN_BRIDGE_STATUS_S=5.0
