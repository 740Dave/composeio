[Unit]
# ComposeIO CAN <-> MQTT bridge ([SPEC:CXC-CAN], DP-CIO-6).
#
# Installed by deploy/can_mqtt_bridge/deploy.sh. Do not hand-edit on the host:
# the repo is the source of truth and the next deploy overwrites this file.
# Tunables live in /etc/default/composeio-can-bridge (also repo-managed).
Description=ComposeIO CAN <-> MQTT bridge
Documentation=file:///opt/composeio-can-bridge/services/can_mqtt_bridge/bridge.py
After=network-online.target can0.service
Wants=network-online.target
# Requires, not Wants: the bridge degrades to MQTT-only if the CAN socket will
# not open, which is a SILENT half-service. Let systemd guarantee the interface
# instead of discovering it in a log line nobody reads.
Requires=can0.service
# A broker outage or a link bounce should retry forever, not trip the burst
# limiter into a permanently failed unit. This key lives in [Unit] — systemd
# 252 (bookworm) parses it in [Service] only to log "Unknown key" and IGNORE
# it, which looks like it worked right up until the fifth restart.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/default/composeio-can-bridge
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/composeio-can-bridge/python
WorkingDirectory=/opt/composeio-can-bridge

# The interface must actually be UP, not merely configured. can0.service is
# Type=oneshot RemainAfterExit=yes, so it reports "active" from a boot in which
# `ip link set up` failed and something else took the link down afterwards.
ExecStartPre=/bin/sh -c 'ip -brief link show "$CAN_INTERFACE" | grep -qw UP'
ExecStart=/opt/composeio-can-bridge/venv/bin/python \
          /opt/composeio-can-bridge/services/can_mqtt_bridge/bridge.py

Restart=always
RestartSec=5

# An AF_CAN/SOCK_RAW socket needs CAP_NET_RAW and nothing else. Ambient cap on
# an unprivileged system user beats running the whole bridge as root.
User=composeio
Group=composeio
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict

# THE ONE WRITABLE PATH, and it exists because ProtectSystem=strict makes the
# whole filesystem read-only. `StateDirectory=` creates
# /var/lib/composeio-can-bridge owned by User=/Group= above and punches exactly
# that path through the read-only bind — no chown in deploy.sh, no path that
# outlives an uninstall.
#
# It holds the LEARNED namespace table (CAN_BRIDGE_REGISTRY_FILE, workstream
# G4): the name->hash pairs announced by CAN nodes, which cannot be re-derived
# from anything on this host. Without it a restart un-names every CAN-only
# device until each board is polled again.
#
# If this line is removed, the bridge does NOT fail: `save_registry` raises,
# the error is logged, `save_errors` increments and it is published on
# `_bridge/<id>/forwarding`. Losing persistence is a degrade, never a stop.
StateDirectory=composeio-can-bridge
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# AF_CAN for the bridge's raw socket; AF_NETLINK because the ExecStartPre `ip`
# check runs inside this same sandbox and RTNETLINK is how it asks the kernel
# anything ("Cannot open netlink socket: Address family not supported").
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_CAN AF_NETLINK
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=can-bridge

[Install]
WantedBy=multi-user.target
