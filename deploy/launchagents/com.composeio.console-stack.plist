<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.composeio.console-stack — bring the Intelligence Console STACK up at login
  ([SPEC:CXC-LAUNCHBAR] [CXC-LB-AUTOSTART]; DEFECT-LAUNCH-BAR-RIBBON-NOT-RUNNING, David 2026-08-04).

  It RunAtLoad-execs the ONE canonical stack bringup (intelligence/start-console-stack.sh), which
  idempotently starts the console GUI + the always-on Launch Bar ribbon + its app_launcher daemon.
  The bringup is a one-shot that spawns the three surfaces detached and exits, so KeepAlive is OFF
  (a KeepAlive would relaunch the one-shot in a loop). The three children each own their own MQTT
  reconnect, so a broker that is briefly unreachable at login is not fatal — they retry.

  ALL PATHS ARE CANONICAL (/Users/davidleeburnett/Dropbox/Maker/composeio) — never a worktree.
  Installed + loaded by deploy/launchagents/install.sh (David runs the live launchctl step).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.composeio.console-stack</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/davidleeburnett/Dropbox/Maker/composeio/intelligence/start-console-stack.sh</string>
    </array>

    <!-- The bringup derives the repo root from its own location, but pin cwd to the canonical repo
         so any repo-relative resolution is unambiguous. -->
    <key>WorkingDirectory</key>
    <string>/Users/davidleeburnett/Dropbox/Maker/composeio</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- so `python3` in the bringup resolves to the same interpreter the stack is built on -->
        <key>PATH</key>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>COMPOSEIO_REPO_ROOT</key>
        <string>/Users/davidleeburnett/Dropbox/Maker/composeio</string>
        <key>MQTT</key>
        <string>mqtt://mqtt-broker.local:1883</string>
    </dict>

    <!-- Start at login. The console + ribbon are Skia/SDL windows, so they need the Aqua GUI session. -->
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <!-- One-shot bringup: do NOT keep alive (the persistent surfaces it spawns live independently). -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/davidleeburnett/Library/Logs/composeio-console-stack.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/davidleeburnett/Library/Logs/composeio-console-stack.error.log</string>
</dict>
</plist>
